# Copy this file to .env and edit. Never commit .env (it is in .gitignore).

# OpenAI-compatible LLM endpoint. Default = local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
# Ollama ignores the key (leave empty). Hosted providers (e.g. Groq) need a real key.
LLM_API_KEY=

# Seconds to wait for the model (first request after Ollama starts loads the model, so be generous)
LLM_TIMEOUT_SECONDS=120

# SQLite file location (defaults to quickfix.db in the project folder)
DB_PATH=
